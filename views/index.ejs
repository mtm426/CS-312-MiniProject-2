<!DOCTYPE html>
<html>
<head>
  <%# Giving the title of the website %>
  <title>Joke Generator</title>
  <%# Giving the stylesheet to use %>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%# Giving a box for the input %>
  <div class="form-container">
    <h1>Get a Personalized Joke</h1>
    <form action="/joke" method="POST">
      <label for="name">Your Name:</label>
      <input type="text" id="name" name="name" placeholder="Enter your name" value="">

      <%# Giving a dropdown for choices %>
      <label for="category">Category:</label>
      <select id="category" name="category">
        <option value="Any">Any</option>
        <option value="Programming">Programming</option>
        <option value="Misc">Misc</option>
        <option value="Dark">Dark</option>
        <option value="Pun">Pun</option>
      </select>

      <button type="submit">Get Joke</button>
    </form>
  </div>

  <%# There are some dark jokes from the api so I wanted to add a disclaimer %>
  <footer>
    <p>⚠️ We are not responsible for offensive jokes. Viewer discretion is advised.</p>
  </footer>
</body>
</html>
