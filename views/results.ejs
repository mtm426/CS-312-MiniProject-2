<!DOCTYPE html>
<html>
<head>
  <title>Your Joke</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="result-box">
    <%# This is where the "customization" comes in %>
    <h1>Here's Your Joke, <%= name || "Friend" %>!</h1>
    <%# Give them the joke %>
    <p><%= joke %></p>

    <%# Sending back to home page if this is clicked to reinput information %>
    <a href="/">Reinput information for another joke.</a>
  </div>

  <footer>
    <p>⚠️ We are not responsible for offensive jokes. Viewer discretion is advised.</p>
  </footer>
</body>
</html>
